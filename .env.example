# ========================================================
# Secure Cloud-Based Question Paper Management System (SC-QPMS)
# Environment Configuration Template
# ========================================================

# MongoDB Atlas Connection String (External persistent database for Vercel)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/sc_qpms_db?retryWrites=true&w=majority

# Cryptographically Secure JWT Secret for authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=c2VjdXJlLWNsb3VkLXF1ZXN0aW9uLXBhcGVyLW1ndC1zeXN0ZW0tc2VjcmV0LWtleS0yMDI2

# Cryptographically Secure AES-256 Symmetric Encryption Key (32 bytes / 256 bits)
# Used to encrypt question paper content before storage in MongoDB
ENCRYPTION_KEY=d9f48a17b8c2e35a09b45e7f123456789abcdef0123456789abcdef01234567

# Comma-separated list of authorized examination center device IDs
# Used for server-side hardware/terminal verification before question paper release
AUTHORIZED_DEVICE_IDS=DEV-EC-HYD-001,DEV-EC-BLR-002,DEV-EC-CHN-003,SECURE-TERMINAL-01

# Public Base URL of the Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
